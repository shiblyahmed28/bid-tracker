# Production environment file for the CentOS 7 VM (36.255.69.114).
# Copy to .env.prod on the VM, fill in every placeholder, and NEVER commit
# the filled-in version. Every secret here must be DISTINCT from the values
# in the repo's .env.example / any developer's local .env.
#
# See docs/DEPLOY.md for the full first-time deploy sequence, including the
# HTTP-then-TLS rollout this file's TLS_ENABLED flag drives.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-to-a-different-random-value-than-dev
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=36.255.69.114
TIME_ZONE=Asia/Dhaka
ALLOWED_EMAIL_DOMAIN=spectrum-bd.com
# Move this off the guessable default before going live — it's a superuser
# escape hatch, not part of the app's own role system (see base.py/urls.py).
DJANGO_ADMIN_URL=admin-change-this-path/

# --- TLS rollout flag -------------------------------------------------
# Step 1 (verify the stack works at all): TLS_ENABLED=0, WEB_PUBLISHED_PORT=8090
# Step 2 (switch to real TLS):            TLS_ENABLED=1, WEB_PUBLISHED_PORT=443
# Do not flip both the app config below AND this flag in the same step —
# see docs/DEPLOY.md "Mode 1" / "Mode 2".
TLS_ENABLED=0
WEB_PUBLISHED_PORT=8090
SITE_ADDRESS=36.255.69.114
ACME_EMAIL=ops@spectrum-bd.com

# --- Origins ------------------------------------------------------------
# Must match whatever WEB_PUBLISHED_PORT/TLS_ENABLED currently is.
# Mode 1 (HTTP, port 8090):
CORS_ALLOWED_ORIGINS=http://36.255.69.114:8090
CSRF_TRUSTED_ORIGINS=http://36.255.69.114:8090
# Mode 2 (TLS, port 443) — switch to these instead, and comment out the pair above:
# CORS_ALLOWED_ORIGINS=https://36.255.69.114
# CSRF_TRUSTED_ORIGINS=https://36.255.69.114

# --- Database -------------------------------------------------------------
POSTGRES_DB=spectrum_bids
POSTGRES_USER=spectrum
POSTGRES_PASSWORD=change-me-to-a-different-password-than-dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# --- Google Sheets sync ---------------------------------------------------
GOOGLE_SHEET_ID=1VH8VTGMsr9oyU7514PtjF4SIm_I2jXzeL0EE1N6Gz-4
GOOGLE_SHEET_TAB=bids
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/service-account.json
SYNC_INTERVAL_HOURS=8

# --- Email ------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Spectrum Bid Tracker <noreply@spectrum-bd.com>
FRONTEND_BASE_URL=http://36.255.69.114:8090
# Switch to https://36.255.69.114 once TLS is live (Mode 2).
